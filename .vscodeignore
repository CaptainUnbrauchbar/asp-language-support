# Development tooling, run from a checkout rather than from the package
scripts/**
eslint.config.mjs

# The readme links these from GitHub with absolute URLs, so shipping the
# originals only makes the download bigger
media/*.gif

# Previously published packages that live in the repository
*.vsix

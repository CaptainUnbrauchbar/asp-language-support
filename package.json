{
    "name": "answer-set-programming-language-support",
    "displayName": "Clingo for VSCode",
    "version": "1.1.0",
    "description": "Language Support for Clingo ASP (developed at University of Potsdam).",
    "publisher": "ffrankreiter",
    "jest": {
        "testPathIgnorePatterns": [
            "src/integrationTests",
            "/.vscode-test/"
        ],
        "modulePathIgnorePatterns": [
            "<rootDir>/.vscode-test/",
            "<rootDir>/coverage/"
        ],
        "watchPathIgnorePatterns": [
            "<rootDir>/.vscode-test/",
            "<rootDir>/coverage/"
        ]
    },
    "engines": {
        "vscode": ">=1.94.0"
    },
    "categories": [
        "Programming Languages",
        "Education",
        "Visualization"
    ],
    "tags": [
        "ASP",
        "Answer Set Programming",
        "Clingo",
        "Potassco",
        "Potsdam",
        "Computational Intelligence"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/CaptainUnbrauchbar/ASP-Language-Support"
    },
    "icon": "images/19286215.png",
    "activationEvents": [
        "onLanguage:asp"
    ],
    "main": "./src/extension.js",
    "contributes": {
        "viewsContainers": {
            "panel": [
                {
                    "id": "aspContainer",
                    "title": "ASP",
                    "icon": "images/19286215.png"
                }
            ]
        },
        "views": {
            "aspContainer": [
                {
                    "type": "webview",
                    "id": "ASP.aspView",
                    "name": "ASP View"
                }
            ]
        },
        "languages": [
            {
                "id": "asp",
                "aliases": [
                    "Answer Set Programming",
                    "Answer Set",
                    "asp",
                    "Clingo",
                    "Potassco",
                    "Logic Program",
                    "Declarative Programming"
                ],
                "extensions": [
                    ".lp",
                    ".ilp",
                    ".cl",
                    ".clp",
                    ".iclp",
                    ".Clp",
                    ".iClp",
                    ".blp",
                    ".iblp"
                ]
            }
        ],
        "configuration": [
            {
                "title": "ASPLanguage",
                "properties": {
                    "aspLanguage.usePathClingo": {
                        "description": "Set this option if you would like to use the Clingo version from your PATH instead of the version included",
                        "type": "boolean",
                        "default": false
                    },
                    "aspLanguage.setConfig": {
                        "markdownDescription": "Name of the clingo config file that **Import from config.json** reads, for example `config.json`. It is looked up next to the .lp file you run and then in **every folder above it**, so one config can serve a whole project.\n\nSolver options live in the panel's own settings, opened with the gear in its toolbar; this setting only says where to import an existing config from. To solve several files together, write `#include \"other.lp\".` in your program instead.",
                        "type": "string",
                        "default": ""
                    }
                }
            }
        ],
        "commands": [
            {
                "command": "answer-set-programming-language-support.runinterminalall",
                "title": "Compute all Answer Sets",
                "icon": "$(notebook-execute-all)"
            },
            {
                "command": "answer-set-programming-language-support.runinterminalsingle",
                "title": "Compute the first Answer Set",
                "icon": "$(notebook-execute)"
            },
            {
                "command": "answer-set-programming-language-support.togglesettings",
                "title": "Solver settings",
                "icon": "$(settings-gear)"
            },
            {
                "command": "answer-set-programming-language-support.stopclingo",
                "title": "Stop the running Clingo solver",
                "icon": "$(debug-stop)"
            },
            {
                "command": "answer-set-programming-language-support.initClingoConfig",
                "title": "ASPLanguage: Initialize clingo config file in current working directory"
            },
            {
                "command": "answer-set-programming-language-support.showreleasenotes",
                "title": "ASPLanguage: Show release notes"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "when": "resourceLangId == asp",
                    "command": "answer-set-programming-language-support.runinterminalall",
                    "group": "z_commands"
                },
                {
                    "when": "resourceLangId == asp",
                    "command": "answer-set-programming-language-support.runinterminalsingle",
                    "group": "z_commands"
                }
            ],
            "view/title": [
                {
                    "command": "answer-set-programming-language-support.runinterminalall",
                    "when": "view == ASP.aspView && resourceLangId == asp",
                    "group": "navigation@2"
                },
                {
                    "command": "answer-set-programming-language-support.runinterminalsingle",
                    "when": "view == ASP.aspView && resourceLangId == asp",
                    "group": "navigation@1"
                },
                {
                    "command": "answer-set-programming-language-support.togglesettings",
                    "when": "view == ASP.aspView",
                    "group": "navigation@3"
                },
                {
                    "command": "answer-set-programming-language-support.stopclingo",
                    "when": "view == ASP.aspView && aspLanguage.clingoRunning",
                    "group": "navigation@4"
                }
            ]
        },
        "keybindings": [
            {
                "command": "answer-set-programming-language-support.runinterminalall",
                "key": "ctrl+shift+a",
                "mac": "cmd+shift+a",
                "when": "editorTextFocus && editorLangId == 'asp'"
            },
            {
                "command": "answer-set-programming-language-support.runinterminalsingle",
                "key": "ctrl+shift+x",
                "mac": "cmd+shift+x",
                "when": "editorTextFocus && editorLangId == 'asp'"
            },
            {
                "command": "answer-set-programming-language-support.stopclingo",
                "key": "ctrl+shift+s",
                "mac": "cmd+shift+s",
                "when": "aspLanguage.clingoRunning"
            }
        ]
    },
    "scripts": {
        "lint": "eslint .",
        "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
        "test:panel": "cross-env NODE_OPTIONS=--experimental-vm-modules jest src/panelTests",
        "fixtures:panel": "node src/panelTests/fixtures/generate.mjs",
        "probe:settings": "node scripts/probe-settings.mjs",
        "test-e2e": "vscode-test"
    },
    "extensionDependencies": [
        "abelcour.asp-syntax-highlight"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vscode/test-cli": "^0.0.11",
        "@vscode/test-electron": "^2.4.1",
        "cross-env": "^10.1.0",
        "eslint": "^10.8.1",
        "globals": "^17.11.0",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.4.1"
    },
    "dependencies": {
        "@vscode/codicons": "0.0.39",
        "ajv": "^8.20.0",
        "clingo-wasm": "^0.6.0",
        "which": "^5.0.0"
    }
}

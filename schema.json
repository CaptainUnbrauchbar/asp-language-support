{
    "title": "ASP Config Schema",
    "description": "",
    "type": "object",
    "properties": {
        "name": { "type": "string" },
        "author": { "type": "string" },
        "version": { "type": "string" },
        "additionalFiles": { "type": "array" },
        "args": {
            "type": "object",
            "properties": {
                "verboseMode": { "type": "integer" },
                "parallelMode": {
                    "type": "object",
                    "properties": {
                        "useParallelMode": { "type": "boolean" },
                        "mode": {
                            "type": "string",
                            "enum": ["compete", "split"]
                        },
                        "threads": { "type": "integer" }
                    },
                    "required": ["useParallelMode", "mode", "threads"]
                },
                "timeLimit": { "type": "integer" },
                "preProcessor": { "type": "boolean" },
                "models": { "type": "integer" },
                "constants": { "type": "array" },
                "customArgs": { "type": "string" }
            }
        }
    },
    "required": ["name", "version", "author"]
}
